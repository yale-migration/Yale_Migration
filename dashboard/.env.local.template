# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local and fill in.  .env.local is gitignored — verify that before
# you paste anything: `git check-ignore -v .env.local` must print a match.
#
# ⛔ Treat every value here as exposed the moment it is pasted anywhere. If one
# ends up in a chat, a screenshot or a commit, ROTATE IT rather than hoping.
# ─────────────────────────────────────────────────────────────────────────────

# From: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⛔ SERVER ONLY. Bypasses RLS entirely. Used by the Sheets sync and nothing
# else. Never in a NEXT_PUBLIC_ variable, never in anything the browser loads.
SUPABASE_SERVICE_ROLE_KEY=

# ── Only if you want me to run migrations for you ────────────────────────────
# ⚠️ A personal access token controls the WHOLE Supabase account, not one
# project. Prefer running the migrations yourself — see the runbook. If you do
# add one, delete it from this file the moment the work is done and revoke it at
# supabase.com/dashboard/account/tokens.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
