# ⛔ NEVER COMMIT A FILLED-IN COPY OF THIS FILE.
#
# Leave every value blank to run on synthetic fixtures — the app detects the
# absence of a URL and serves demo data instead. That is the ONLY supported way
# to run this locally, because real client data must never sit on a personal
# machine.

# Company Supabase project only. Not a personal account, not a free tier —
# free projects pause after a week of inactivity, and this holds visa
# applicant PII.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⛔ SERVER ONLY. Bypasses RLS completely — that is its purpose and its danger.
# Used by the Sheets sync job and nothing else. It must never appear in any file
# the browser can reach, and never in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# Guards /api/sync, which runs with the service-role key and can rewrite the
# client register. Any long random string. ⛔ Without it the route refuses every
# request — that is the safe default, not a misconfiguration.
SYNC_SECRET=

# ── Google Sheets sync (D-401) ─────────────────────────────────────────────
# The service account that READS the client register. Viewer access only.
# ⛔ Never paste the private key anywhere but the host's encrypted env store.
GOOGLE_SERVICE_ACCOUNT_EMAIL=yale-dashboard-sync@<project>.iam.gserviceaccount.com
# The `private_key` field from the downloaded JSON, INCLUDING the BEGIN/END
# lines. Newlines may be pasted literally or as \n — both are handled.
GOOGLE_PRIVATE_KEY=
# Optional. Defaults to the live workbook id already in the code.
YALE_SHEET_ID=
