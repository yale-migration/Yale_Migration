assets/samples/*
!assets/samples/.gitkeep
.DS_Store
# Secrets. `*.env` alone does NOT catch `.env.local` — verified with
# `git check-ignore` on 19 Aug, it came back NOT IGNORED (D-340).
*.key
*.env
.env
.env.*
# ...but the TEMPLATES carry no secrets and MUST be committed — otherwise the
# next person has no idea which variables the app needs. `.env.*` above is
# deliberately broad; these two are the deliberate exceptions.
!.env.example
!*.env.example
!.env.local.template
!*.env.local.template
*.pem
*credentials*.json
creds*.json
*secret*.json
*token*.json

# --- client PII must never be tracked (CLAUDE.md hard rule; enforced 2026-08-02, D-143) ---
docs/**/Team roster.docx
docs/**/Model folder.docx
docs/Answer to the questions..docx
*.docx.pii

# 🔴 CLIENT DATA — NEVER COMMIT (D-300)
# Their live client tracker and enquiry log contain names, phones, emails AND
# plaintext portal passwords. They live OUTSIDE this repo, in SOP'S/ root, and
# must stay there. These patterns are a second line of defence only.
/DATA SHEET.xlsx
/client-data/
client-data/
/*GAMOL*
/*CLIENT TRACKER*
/*DATA SHEET*
