{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/git-guard.py",
            "timeout": 120,
            "statusMessage": "Checking repo hygiene before commit…"
          }
        ]
      }
    ]
  }
}
